package com.example.prova1

import android.os.Bundle
import android.widget.EditText
import android.widget.ImageButton
import android.widget.Toast
import androidx.activity.enableEdgeToEdge
import androidx.appcompat.app.AppCompatActivity
import androidx.core.view.ViewCompat
import androidx.core.view.WindowInsetsCompat

class Trasferir : AppCompatActivity() {

    private lateinit var valorTransferencia: EditText
    private lateinit var btnTransferencia: ImageButton

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        enableEdgeToEdge()
        setContentView(R.layout.activity_trasferir)

        // Inicializando os componentes
        valorTransferencia = findViewById(R.id.valorTransferencia)
        btnTransferencia = findViewById(R.id.btntranferencia)

        // Configurando o listener do botão
        btnTransferencia.setOnClickListener {
            realizarTransferencia()
        }

        ViewCompat.setOnApplyWindowInsetsListener(findViewById(R.id.Transferir)) { v, insets ->
            val systemBars = insets.getInsets(WindowInsetsCompat.Type.systemBars())
            v.setPadding(systemBars.left, systemBars.top, systemBars.right, systemBars.bottom)
            insets
        }
    }

    private fun realizarTransferencia() {
        val valor = valorTransferencia.text.toString()

        if (valor.isNotEmpty()) {
            // Aqui você pode adicionar a lógica para processar a transferência
            Toast.makeText(this, "Transferência de R$ $valor realizada com sucesso!", Toast.LENGTH_SHORT).show()
        } else {
            Toast.makeText(this, "Por favor, insira um valor para a transferência.", Toast.LENGTH_SHORT).show()
        }
    }
}
