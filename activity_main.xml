<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#8A05BE"
        app:title="Olá, Juan"
        app:titleTextColor="#FFFFFF">

        <Button
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginLeft="100dp"
            android:backgroundTint="#8A05BE"
            android:padding="14dp"
            app:icon="@drawable/olho"
            app:iconSize="24dp" />

        <Button
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:backgroundTint="#8A05BE"
            android:padding="14dp"
            app:icon="@drawable/interrogacao"
            app:iconSize="24dp" />

        <Button
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:backgroundTint="#8A05BE"
            android:padding="14dp"
            app:icon="@drawable/email"
            app:iconSize="24dp" />
    </androidx.appcompat.widget.Toolbar>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginLeft="10dp"
            android:text="Conta"
            android:textSize="24sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:text="R$69.000"
            android:textSize="24sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        tools:context=".MainActivity">

        <ImageButton
            android:id="@+id/btnAbrirPix"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginLeft="70dp"
            android:background="@drawable/circulo"
            android:padding="14dp"
            android:src="@drawable/pix" />

        <ImageButton
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginLeft="5dp"
            android:background="@drawable/circulo"
            android:padding="14dp"
            android:src="@drawable/payment" />

        <ImageButton
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginLeft="5dp"
            android:background="@drawable/circulo"
            android:padding="14dp"
            android:src="@drawable/cima" />

        <ImageButton
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginLeft="5dp"
            android:background="@drawable/circulo"
            android:padding="14dp"
            android:src="@drawable/baixo" />

    </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp">


        </LinearLayout>

    <Button
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="20dp"
        android:gravity="center"
        android:padding="14dp"
        app:icon="@drawable/cartao"
        app:iconTint="@color/black"
        android:text="Meus Cartões"
        android:backgroundTint="#D9D9D9"
        android:textColor="#000000" />

    <Button
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="20dp"
        android:gravity="center"
        android:padding="14dp"
        android:text="Conheça Nubank Vida: um seguro simples e que cabe no seu bolso"
        android:backgroundTint="#D9D9D9"
        android:textColor="#000000" />

    <Button
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="30dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="20dp"
        android:gravity="center"
        android:padding="14dp"
        app:icon="@drawable/cartao"
        app:iconTint="@color/black"
        android:backgroundTint="#FFF6FD"
       />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:text="Cartão de Crédito"
        android:textSize="20dp"
        android:textColor="@color/black"
    />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:text="Fatura Atual"
        android:textSize="15dp"
        />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="20dp"
        android:text="R$ 15.789"
        android:textSize="20dp"
        android:textColor="@color/black"
        />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:text="Limite disponivel de R$ 32.450,00"
        android:textSize="15dp"
        />

</LinearLayout>
